# ---------------------------------------------------------------------------
# IncidentIQ - local development environment
#
#   cp infrastructure/docker/.env.example infrastructure/docker/.env
#
# These values are for LOCAL DEVELOPMENT ONLY. .env is git-ignored; nothing in
# this file is a real credential and nothing here should ever be reused in a
# deployed environment, where these variables come from the platform's secret
# store instead.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=incidentiq

# ---------- PostgreSQL ----------
POSTGRES_DB=incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_HOST_PORT=5433

# ---------- Kafka ----------
# Generate a new one with: docker run --rm confluentinc/cp-kafka:7.8.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=IRoK_H6BRkKVAcv26WKWWQ
KAFKA_HOST_PORT=29092

# ---------- Redis ----------
# Provisioned now, not yet used by any service. See docs/architecture.
REDIS_PASSWORD=dev_only_change_me
REDIS_HOST_PORT=6380

# ---------- MinIO (S3-compatible object storage) ----------
# Provisioned now for the future cold-storage log archive.
MINIO_ROOT_USER=incidentiq
MINIO_ROOT_PASSWORD=dev_only_change_me
MINIO_BUCKET=incidentiq-logs
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- Monitoring ----------
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_only_change_me

# ---------- Application ----------
ASPNETCORE_ENVIRONMENT=Development
# json | text
LOG_FORMAT=json
LOG_LEVEL=INFO

API_HOST_PORT=5080
INGESTION_HOST_PORT=5081
EVENT_PROCESSOR_HOST_PORT=5082
AI_ANALYSIS_HOST_PORT=5083
WEB_HOST_PORT=3000

# Origins allowed to call the services from a browser.
# The nginx-served app, plus the Vite dev server for "npm run dev".
WEB_ORIGIN=http://localhost:3000
VITE_DEV_ORIGIN=http://localhost:5173
