# ---------------------------------------------------------------------------
# IncidentIQ - local development environment
#
#   cp infrastructure/docker/.env.example infrastructure/docker/.env
#
# These values are for LOCAL DEVELOPMENT ONLY. .env is git-ignored; nothing in
# this file is a real credential and nothing here should ever be reused in a
# deployed environment, where these variables come from the platform's secret
# store instead.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=incidentiq

# ---------- PostgreSQL ----------
POSTGRES_DB=incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_HOST_PORT=5433

# ---------- Kafka ----------
# Generate a new one with: docker run --rm confluentinc/cp-kafka:7.8.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=IRoK_H6BRkKVAcv26WKWWQ
KAFKA_HOST_PORT=29092

# ---------- Redis ----------
# Provisioned now, not yet used by any service. See docs/architecture.
REDIS_PASSWORD=dev_only_change_me
REDIS_HOST_PORT=6380

# ---------- MinIO (S3-compatible object storage) ----------
# Provisioned now for the future cold-storage log archive.
MINIO_ROOT_USER=incidentiq
MINIO_ROOT_PASSWORD=dev_only_change_me
MINIO_BUCKET=incidentiq-logs
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- Monitoring ----------
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_only_change_me

# ---------- Application ----------
ASPNETCORE_ENVIRONMENT=Development
# json | text
LOG_FORMAT=json
LOG_LEVEL=INFO

API_HOST_PORT=5080
INGESTION_HOST_PORT=5081
EVENT_PROCESSOR_HOST_PORT=5082
AI_ANALYSIS_HOST_PORT=5083
WEB_HOST_PORT=3000

# Origins allowed to call the services from a browser.
# The nginx-served app, plus the Vite dev server for "npm run dev".
WEB_ORIGIN=http://localhost:3000
VITE_DEV_ORIGIN=http://localhost:5173

# ---------- Database bootstrap (local development only) ----------
# Applying migrations from the application is a convenience, not a pattern to
# copy into production: two replicas starting together will race for the lock.
DB_RUN_MIGRATIONS_ON_STARTUP=true
# Platform roles. Reference data, safe in any environment.
DB_SEED_REFERENCE_DATA=true
# Two sample organizations, so tenant isolation is visible. Development only.
DB_SEED_DEVELOPMENT_DATA=true

# ---------- Development-only endpoints ----------
# Enables POST /dev/publish/* on the ingestion service, which publishes
# synthetic events so the Kafka path can be exercised. Never enable elsewhere.
ENABLE_DEV_ENDPOINTS=true

# ---------- Ingestion API key ----------
# Only the hash is configured; the raw key belongs to the client.
# Local development key (safe to share, valid only here):
#   iiq_dev_0123456789abcdef
INGESTION_API_KEY_HASH=0124480e2ea1f82551e5fee97813a55dcea5698fd6b3c380c75a44eb0e18314e
INGESTION_API_KEY_TENANT_ID=11111111-1111-1111-1111-111111111111
INGESTION_API_KEY_NAME=acme-local-dev

# ---------- LLM narration (optional) ----------
# Leave blank to run the deterministic pipeline with template summaries.
# The key is passed through to the worker; it is never baked into an image.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
